# BrideGuide Admin - Environment Variables Template
# Copy this file to .env.local and fill in the values

# Your Supabase Project URL (e.g. https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Your Supabase Public Anon Key (e.g. eyJhbGciOiJIUzI1NiIsInR5cCI...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Your Supabase Service Role Key (REQUIRED for admin operations/RLS bypass)
# WARNING: Keep this secure! NEVER expose it on the client or push it to GitHub!
SUPABASE_SERVICE_ROLE_KEY=
